generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enum-like strings are checked by scripts/validate-data.js.
model User {
  id        String    @id @default(cuid())
  email     String    @unique // must end in .edu
  name      String?
  gender    String? // BROTHER | SISTER
  createdAt DateTime  @default(now())
  listings  Listing[]
}

model Listing {
  id           String   @id @default(cuid())
  title        String
  address      String
  lat          Float
  lng          Float
  // Room setup
  propertyType String   @default("APARTMENT") // HOUSE | APARTMENT | CONDO | TOWNHOUSE
  roomType     String // PRIVATE | SHARED
  // Capacity
  totalRoommates Int
  beds         Int
  baths        Float
  // Financials (USD / month)
  totalRent    Int
  rentShare    Int
  avgUtilities Int
  // Rules & amenities
  petsAllowed  Boolean  @default(false)
  halalKitchen Boolean  @default(true)
  genderPref   String // BROTHERS | SISTERS | ANY
  description  String?
  // Photo tour: exterior first, then rooms. Empty means the UI falls back to a satellite view.
  photos       String[] @default([])
  contactEmail String
  createdAt    DateTime @default(now())
  ownerId      String?
  owner        User?    @relation(fields: [ownerId], references: [id])
}
